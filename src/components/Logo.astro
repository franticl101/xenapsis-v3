---
/** Inline SVG: no network request, no layout shift, scales with text. */
interface Props { size?: number; }
const { size = 26 } = Astro.props as Props;
---
<svg width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
  <rect width="32" height="32" rx="8" fill="var(--brand)" />
  <path d="M9 9.5 23 22.5M23 9.5 9 22.5" stroke="#fff" stroke-width="2.6" stroke-linecap="round" />
  <circle cx="16" cy="16" r="3.4" fill="var(--brand)" stroke="#fff" stroke-width="2.2" />
</svg>
