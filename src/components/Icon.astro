---
/** Small inline icon set. Decorative by default; pass `label` to expose it. */
const PATHS = {
  check: 'M20 6 9 17l-5-5',
  clock: 'M12 7v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
  lock: 'M7 11V8a5 5 0 0 1 10 0v3M5 11h14v10H5z',
  bolt: 'M13 2 4 14h7l-1 8 9-12h-7l1-8Z',
  chart: 'M4 20V10M10 20V4M16 20v-7M22 20H2',
  compass: 'M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM15.5 8.5l-2 5-5 2 2-5 5-2Z',
} as const;

export type IconName = keyof typeof PATHS;

interface Props { name: IconName; size?: number; label?: string; }
const { name, size = 18, label } = Astro.props as Props;
---
<svg
  width={size} height={size} viewBox="0 0 24 24" fill="none"
  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
><path d={PATHS[name]} /></svg>
